# Salin menjadi .env lalu isi
PORT=3000

# PostgreSQL (Neon / Supabase / lokal)
DATABASE_URL=postgres://user:password@host:5432/ngedate
# true untuk Neon/Supabase (koneksi wajib SSL)
DATABASE_SSL=true

# Isi dengan teks acak panjang (minimal 32 karakter), JANGAN dibagikan
JWT_SECRET=
REFRESH_TOKEN_SECRET=

NODE_ENV=production

# Alamat publik server (untuk link foto), contoh: https://api.amora.app
PUBLIC_URL=
# Folder penyimpanan foto (opsional)
UPLOAD_DIR=

# Dipakai oleh `npm run seed` untuk membuat admin pertama
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

{
  "expo": {
    "name": "Amora",
    "slug": "amora",
    "scheme": "amora",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5FA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.amora.chat"
    },
    "android": {
      "package": "app.amora.chat",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF5FA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Amora butuh akses galeri untuk memilih foto profil dan album.",
          "microphonePermission": false,
          "cameraPermission": "Amora butuh kamera untuk foto profil dan verifikasi wajah."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8B5CF6"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Amora butuh kamera untuk verifikasi wajah host.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "",
      "eas": {
        "projectId": "143ecaba-6bd8-45ad-9168-7a90f771884e"
      }
    },
    "owner": "meong11",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/143ecaba-6bd8-45ad-9168-7a90f771884e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
